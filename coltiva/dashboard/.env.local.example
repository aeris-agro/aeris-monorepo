# Coltiva dashboard — environment variables
# Copy to .env.local and fill in.

# Backend URL (Coltiva FastAPI)
# Local: http://localhost:8001
# Prod:  https://coltiva-backend-production.up.railway.app
NEXT_PUBLIC_COLTIVA_API_URL=http://localhost:8001

# Marketing/website URL — where to redirect on logout
# Local: http://localhost:3002
# Prod:  https://coltiva.aeris.agro (or coltiva-website.vercel.app)
NEXT_PUBLIC_COLTIVA_WEBSITE_URL=http://localhost:3002
