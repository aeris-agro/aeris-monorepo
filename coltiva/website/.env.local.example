# Coltiva website — environment variables
# Copy to .env.local and fill in.

# Coltiva backend URL — used by Next.js's API rewrite proxy.
# Local dev: http://localhost:8001
# Production: https://coltiva-backend-production.up.railway.app
NEXT_PUBLIC_COLTIVA_API_URL=http://localhost:8001

# Coltiva dashboard URL — where users land after a successful login.
# Local dev: http://localhost:3003
# Production: https://app.coltiva.aeris.agro
NEXT_PUBLIC_COLTIVA_DASHBOARD_URL=http://localhost:3003

# Public site URL — used for OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
